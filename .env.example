# ============================================================================
# ATOLLHUB MULTI-SHOP E-COMMERCE, POS & INVENTORY PLATFORM - CONFIGURATION
# Copy this file to .env and replace placeholder values before running.
# NEVER commit your actual .env file to version control.
# ============================================================================

# Server Environment
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@localhost:5432/atollhub_multishop
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20

# Authentication & Security Secrets (Generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_HEX_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_64_BYTE_HEX_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
SESSION_COOKIE_SECURE=false
CSRF_PROTECTION_ENABLED=true
BCRYPT_SALT_ROUNDS=12

# Initial Master Administrator Setup (Used only on first bootstrap via npm run setup:admin)
INITIAL_MASTER_ADMIN_EMAIL=admin@atollhub.mv
INITIAL_MASTER_ADMIN_NAME=Platform Master Administrator
# Do not hardcode passwords in production; pass via CLI or set temporarily during bootstrap:
INITIAL_MASTER_ADMIN_PASSWORD=

# Storage Configuration (local | s3)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
S3_BUCKET_NAME=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Optional Exchange Rate API (for automated live currency sync)
# Supports exchangerate-api.com or openexchangerates.org
EXCHANGE_RATE_API_PROVIDER=manual
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_BASE_CURRENCY=MVR

# Optional WhatsApp Business Cloud API (Meta Graph API)
# Note: Click-to-Chat (wa.me) and Viber links work out-of-the-box without API keys.
WHATSAPP_CLOUD_API_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Optional SMTP Email Notifications
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AtollHub Platform <noreply@atollhub.mv>"
